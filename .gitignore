# Ignore Python bytecode files
*.pyc
.vscode
.ipynb_checkpoints
.DS_Store
**/__pycache__

# Never commit databases — they contain user data and OAuth tokens
# Only the blank schema template is tracked (no user data)
instance/database_prod.db
instance/database_dev.db
instance/*.db
!instance/database_template.db

# Do not track test scripts made for dev purposes.
BeautifulSoup_test.ipynb

# Environment variables (contains secrets)
.env

# DB backups (timestamped copies, never commit)
backups/

# React Native / Expo
mobile/node_modules
mobile/.expo