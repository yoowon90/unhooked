# Copy this file to .env and fill in the values. .env is gitignored.

# development | production
FLASK_ENV=development

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
JWT_SECRET_KEY=

# Get from https://console.anthropic.com → API Keys
# Used by the Gmail backfill flow (parses order emails with Claude Haiku)
ANTHROPIC_API_KEY=

# Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID
# See ROADMAP.md "Google Cloud OAuth setup" for full step-by-step
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Optional — the app builds the redirect URI from the running request, so this
# is only used as a fallback. The redirect must also be registered in Google Cloud.
GOOGLE_REDIRECT_URI=http://localhost:5001/connectors/gmail/callback
